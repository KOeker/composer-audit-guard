{
  "name": "koeker/composer-audit-guard",
  "version": "1.0.1",
  "description": "CLI tool for Composer security audit with blacklist functionality and JUnit XML reports",
  "type": "library",
  "keywords": [
    "composer",
    "audit",
    "security",
    "vulnerabilities",
    "cli",
    "dependencies",
    "blacklist",
    "junit",
    "ci-cd",
    "vulnerability-scanner",
    "security-audit",
    "composer-audit",
    "devops",
    "php"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "KOeker"
    }
  ],
  "require": {
    "php": ">=8.0",
    "symfony/console": "^6.0|^7.0",
    "symfony/process": "^6.0|^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "ComposerAuditGuard\\": "src/"
    }
  },
  "bin": [
    "bin/composer-audit-guard"
  ],
  "scripts": {
    "test": "phpunit tests"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
